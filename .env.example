# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Configuration
EXPO_PUBLIC_APP_NAME=My Expo App
EXPO_PUBLIC_SLUG=my-expo-app
EXPO_PUBLIC_SCHEME=myexpoapp

# Bundle Identifiers
EXPO_PUBLIC_IOS_BUNDLE_ID=com.company.myapp
EXPO_PUBLIC_ANDROID_PACKAGE=com.company.myapp

# API Configuration
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_APP_VERSION=1.0.0

# API Endpoints (if needed for custom endpoints)
EXPO_PUBLIC_API_LOGIN_ENDPOINT=/auth/login
EXPO_PUBLIC_API_REGISTER_ENDPOINT=/auth/register
EXPO_PUBLIC_API_USER_ENDPOINT=/auth/me

# Environment
NODE_ENV=development

# EAS Configuration
EAS_PROJECT_ID=your-eas-project-id-here

# Error Tracking (Sentry)
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=your-sentry-project

# Analytics
EXPO_PUBLIC_ANALYTICS_API_KEY=your-analytics-api-key-here

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Development Only (comment out in production)
EXPO_PUBLIC_DEBUG_MODE=true

# Storage Encryption
EXPO_PUBLIC_STORAGE_KEY=your-random-256-bit-encryption-key-here

# Mock API Configuration
# Set to 'true' to enable mock API (no backend required)
# Auto-enabled in dev when EXPO_PUBLIC_API_URL is not set
EXPO_PUBLIC_MOCK_API=true

# Mock API Test Accounts:
# - Email: john@example.com, Password: 123456
# - Email: jane@example.com, Password: 123456
# - Email: bob@example.com, Password: password