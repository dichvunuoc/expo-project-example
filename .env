# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Configuration
EXPO_PUBLIC_APP_NAME=Expo Techgen Template
EXPO_PUBLIC_SLUG=com-techgen-template
EXPO_PUBLIC_SCHEME=com-techgen-template
EXPO_PUBLIC_DEEP_LINK_HOST=demo.cudanso.vn

# Bundle Identifiers
EXPO_PUBLIC_IOS_BUNDLE_ID=com.techgen.expo
EXPO_PUBLIC_ANDROID_PACKAGE=com.techgen.expo

# API Configuration
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_API_VERSION=v1
# EXPO_PUBLIC_APP_VERSION=1.0.0

# API Endpoints (if needed for custom endpoints)
# EXPO_PUBLIC_API_LOGIN_ENDPOINT=/auth/login
# EXPO_PUBLIC_API_REGISTER_ENDPOINT=/auth/register
# EXPO_PUBLIC_API_USER_ENDPOINT=/auth/me

# Environment
NODE_ENV=development

# EAS Configuration
EAS_PROJECT_ID=

# Error Tracking (Sentry)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Analytics
EXPO_PUBLIC_ANALYTICS_API_KEY=

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Development Only (comment out in production)
EXPO_PUBLIC_DEBUG_MODE=true
